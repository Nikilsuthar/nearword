{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z0-9]{5}$/)"
      }
    },
    "daily": {
      "$day": {
        "$tier": {
          ".read": true,
          ".indexOn": ["score"],
          "$pid": {
            ".write": true,
            ".validate": "newData.hasChildren(['name', 'score', 'guesses']) && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('score').isNumber()"
          }
        }
      }
    }
  }
}
