{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z0-9]{5}$/)",
        "players": {
          "$pid": {
            ".validate": "newData.hasChildren(['name', 'best', 'guesses'])"
          }
        }
      }
    }
  }
}
